{
  "name": "happy-finance-journey", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "content": "node scripts/content.mjs",
    "dev": "npm run content && vite",
    "check": "tsc --noEmit",
