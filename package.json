    "preview": "vite preview"
  },
  "dependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "devDependencies": { "@types/node": "^26.6.3", "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0", "typescript": "^5.9.3", "vite": "^8.0.0", "marked": "^17.0.0", "sanitize-html": "^2.17.0" }
}
